{
  "name": "@haz-que-vuelva/marketing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify:upsell-copy && next build",
    "build:cloudflare": "npm run verify:upsell-copy && opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "check:cloudflare": "npm run verify:upsell-copy && opennextjs-cloudflare build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:upsell-copy": "node scripts/compile-upsell-copy.mjs",
    "verify:upsell-copy": "node scripts/compile-upsell-copy.mjs --check && node scripts/verify-upsell-copy.mjs",
    "test:upsells": "npm run verify:upsell-copy && node scripts/test-upsell-contracts.mjs",
    "lint": "eslint .",
    "typecheck": "npm run verify:upsell-copy && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.2.8",
    "@fontsource/source-sans-3": "^5.2.8",
    "@opennextjs/cloudflare": "1.20.2",
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "typescript": "^5",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "12.0.0"
    },
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.9"
    },
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "undici": "7.29.0"
  }
}
