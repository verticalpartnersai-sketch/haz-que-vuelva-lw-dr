{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "upload": "opennextjs-cloudflare build && wrangler versions upload --env production",
    "deploy": "opennextjs-cloudflare build && wrangler deploy --env production",
    "check:cloudflare": "opennextjs-cloudflare build && wrangler deploy --dry-run --env production",
    "check:cloudflare:preview": "opennextjs-cloudflare build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "admin:promote": "node scripts/promote-admin.mjs",
    "admin:bootstrap": "node scripts/bootstrap-first-admin.mjs",
    "content:preflight": "node --experimental-strip-types scripts/content-release-preflight.mjs",
    "payment:verify": "node scripts/verify-perfectpay-sale.mjs"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.0.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "12.0.0"
    },
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
