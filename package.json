{
  "name": "haz-que-vuelva",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:marketing": "npm --prefix apps/marketing run dev -- --hostname 127.0.0.1 --port 3001",
    "build:web": "npm --prefix apps/web run build",
    "build:marketing": "npm --prefix apps/marketing run build",
    "build:cloudflare:web": "npm --prefix apps/web run build:cloudflare",
    "build:cloudflare:marketing": "npm --prefix apps/marketing run build:cloudflare",
    "check:cloudflare:web": "npm --prefix apps/web run check:cloudflare",
    "check:cloudflare:marketing": "npm --prefix apps/marketing run check:cloudflare",
    "check:cloudflare:agent": "npm --prefix apps/agent run check",
    "cloudflare:rum": "node scripts/configure-cloudflare-rum.mjs",
    "check:supabase:migrations": "node scripts/check-supabase-migrations.mjs && node scripts/test-check-supabase-migrations.mjs",
    "check:web": "npm --prefix apps/web run typecheck && npm --prefix apps/web run lint && npm --prefix apps/web test",
    "check:marketing": "npm --prefix apps/marketing run typecheck"
  }
}
